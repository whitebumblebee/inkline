{
  "name": "inkline",
  "displayName": "Inkline",
  "description": "A focused Markdown editor for VS Code-compatible editors.",
  "version": "0.5.0",
  "publisher": "shishirjha",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/whitebumblebee/inkline.git"
  },
  "bugs": {
    "url": "https://github.com/whitebumblebee/inkline/issues"
  },
  "homepage": "https://github.com/whitebumblebee/inkline#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "writing",
    "prose"
  ],
  "activationEvents": [
    "onCommand:inkline.open",
    "onCustomEditor:inkline.markdownEditor",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inkline.open",
        "title": "Open in Inkline",
        "category": "Inkline",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "inkline.openNative",
        "title": "Inkline: Reopen in Native Markdown Editor"
      },
      {
        "command": "inkline.insertImage",
        "title": "Insert Image",
        "category": "Inkline"
      },
      {
        "command": "inkline.toggleReadingMode",
        "title": "Toggle Reading Mode",
        "category": "Inkline",
        "icon": "$(book)"
      },
      {
        "command": "inkline.chooseTheme",
        "title": "Choose Theme",
        "category": "Inkline",
        "icon": "$(symbol-color)"
      },
      {
        "command": "inkline.enterReadingMode",
        "title": "Switch to Reading Mode",
        "category": "Inkline",
        "icon": "$(book)"
      },
      {
        "command": "inkline.exitReadingMode",
        "title": "Switch to Editing",
        "category": "Inkline",
        "icon": "$(edit)"
      }
    ],
    "customEditors": [
      {
        "viewType": "inkline.markdownEditor",
        "displayName": "Inkline Markdown Editor",
        "selector": [
          {
            "filenamePattern": "**/*.md"
          },
          {
            "filenamePattern": "**/*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Inkline",
      "properties": {
        "inkline.assetsDirectory": {
          "type": "string",
          "default": ".inkline-assets",
          "description": "Workspace-relative directory for images inserted by Inkline."
        },
        "inkline.theme": {
          "type": "string",
          "default": "ink",
          "enum": [
            "ink",
            "paper",
            "fjord",
            "dusk",
            "forest",
            "mono"
          ],
          "enumItemLabels": [
            "Ink",
            "Paper",
            "Fjord",
            "Dusk",
            "Forest",
            "Mono"
          ],
          "enumDescriptions": [
            "Warm charcoal and amber; parchment in light.",
            "Sepia like an old book; easy on the eyes for long reading.",
            "Cool blue-grey and frost, inspired by the north.",
            "Soft violet evening with rose accents; dawn pink in light.",
            "Deep evergreen and sage; morning mist in light.",
            "Greyscale and nothing else; maximum focus on the words."
          ],
          "markdownDescription": "Inkline's colour theme. Each comes in dark and light; see `#inkline.appearance#`. **Inkline: Choose Theme** previews them."
        },
        "inkline.appearance": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Light or dark to match VS Code's colour theme.",
            "Always the theme's light version.",
            "Always the theme's dark version."
          ],
          "description": "Whether Inkline uses its theme's light or dark version."
        }
      }
    },
    "keybindings": [
      {
        "command": "inkline.handledByEditor",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      },
      {
        "command": "inkline.handledByEditor",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      },
      {
        "command": "inkline.handledByEditor",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      },
      {
        "command": "inkline.handledByEditor",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      },
      {
        "command": "inkline.handledByEditor",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      },
      {
        "command": "inkline.toggleReadingMode",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == inkline.markdownEditor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "inkline.open",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "inkline.enterReadingMode",
          "when": "activeCustomEditorId == inkline.markdownEditor && !inkline.readingMode",
          "group": "navigation@1"
        },
        {
          "command": "inkline.exitReadingMode",
          "when": "activeCustomEditorId == inkline.markdownEditor && inkline.readingMode",
          "group": "navigation@1"
        },
        {
          "command": "inkline.chooseTheme",
          "when": "activeCustomEditorId == inkline.markdownEditor",
          "group": "navigation@2"
        },
        {
          "command": "inkline.toggleReadingMode",
          "when": "activeCustomEditorId == inkline.markdownEditor",
          "group": "inkline@1"
        },
        {
          "command": "inkline.chooseTheme",
          "when": "activeCustomEditorId == inkline.markdownEditor",
          "group": "inkline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "inkline.openNative",
          "when": "activeCustomEditorId == inkline.markdownEditor"
        },
        {
          "command": "inkline.insertImage",
          "when": "activeCustomEditorId == inkline.markdownEditor"
        },
        {
          "command": "inkline.toggleReadingMode",
          "when": "activeCustomEditorId == inkline.markdownEditor"
        },
        {
          "command": "inkline.enterReadingMode",
          "when": "false"
        },
        {
          "command": "inkline.exitReadingMode",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:webview": "vite build --config vite.config.ts",
    "build:extension": "node esbuild.mjs",
    "build": "npm run build:webview && npm run build:extension",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:interaction": "vitest run --run test/editor-interaction.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && vsce package --allow-missing-repository",
    "release-notes": "node scripts/release-notes.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "codemirror": "^6.0.2",
    "katex": "^0.18.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
